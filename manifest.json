{
  "manifest_version": 3,
  "name": "Captain",
  "version": "0.4.0",
  "description": "One helm, open seas. Proxy, privacy, focus, vault, AI, and tab control — unified.",
  "permissions": [
    "tabs",
    "activeTab",
    "bookmarks",
    "browsingData",
    "history",
    "scripting",
    "search",
    "storage",
    "unlimitedStorage",
    "sessions",
    "alarms",
    "webNavigation",
    "contextMenus",
    "offscreen",
    "privacy",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "proxy",
    "management",
    "idle"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png",
      "32": "assets/icon32.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png",
    "32": "assets/icon32.png"
  },
  "commands": {
    "open-captain": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open Captain command palette"
    }
  },
  "content_scripts": [],
  "options_ui": {
    "page": "pages/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "matches": ["<all_urls>"],
      "resources": [
        "content/overlay.css",
        "content/overlay-inner.html",
        "content/overlay-inner.js",
        "inject/ua-spoof.js",
        "inject/webrtc-block.js"
      ]
    },
    {
      "matches": ["chrome-extension://*/*"],
      "resources": [
        "assets/*",
        "assets/fonts/*",
        "ticker.html",
        "ticker.js"
      ]
    },
    {
      "matches": ["chrome-extension://*/*"],
      "resources": [
        "pages/blocked.html",
        "pages/blocked.js",
        "pages/delayed.html",
        "pages/delayed.js",
        "pages/lockdown.html",
        "pages/lockdown.js",
        "pages/options.html",
        "pages/options.js",
        "pages/password.html",
        "pages/password.js",
        "pages/shared.css",
        "pages/vault.html",
        "pages/vault.js",
        "pages/ai.html",
        "pages/ai.js"
      ]
    }
  ]
}
